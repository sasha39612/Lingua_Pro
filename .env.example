# Example environment variables for Lingua Pro
# Copy to .env and fill in real values before running with Docker Compose.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=lingua
POSTGRES_PASSWORD=secret
# lingua_admin is the default admin DB; each service uses its own DB below.

# ── Per-service database URLs ──────────────────────────────────────────────
# Each service has an isolated database on the shared postgres container.
# Use service name 'postgres' as host when running inside Docker Compose.
# Use 'localhost' as host when running services directly (local dev).
DATABASE_URL_AUTH=postgresql://lingua:secret@postgres:5432/auth_db
DATABASE_URL_TEXT=postgresql://lingua:secret@postgres:5432/text_db
DATABASE_URL_AUDIO=postgresql://lingua:secret@postgres:5432/audio_db
DATABASE_URL_AI_ORCHESTRATOR=postgresql://lingua:secret@postgres:5432/ai_orchestrator_db

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=supersecret
JWT_EXPIRY=7d

# Shared secret for internal service-to-service auth (never expose to browser)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-here

# ── AI / OpenAI ────────────────────────────────────────────────────────────
# Used by ai-orchestrator for all OpenAI operations.
AI_API_KEY=your_openai_api_key_here

# Model overrides (defaults shown)
OPENAI_TEXT_MODEL=gpt-4o            # text analysis (reading/writing)
OPENAI_TASK_MODEL=gpt-4o-mini       # task generation
OPENAI_EVAL_MODEL=gpt-4o            # pronunciation feedback (GPT explanation only — no scoring)
OPENAI_TRANSCRIPTION_MODEL=whisper-1  # Whisper fallback when Azure unavailable
OPENAI_TTS_MODEL=gpt-4o-mini-tts    # TTS for listening task audio

# ── Azure Speech Services ───────────────────────────────────────────────────
# Primary transcription + pronunciation scoring (phoneme-level accuracy).
# If unset, ai-orchestrator falls back to Whisper + local scoring.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=westeurope

# Used by audio-service as a direct-Whisper fallback when ai-orchestrator is
# unreachable. Set to the same value as AI_API_KEY.
OPENAI_API_KEY=your_openai_api_key_here

# ── Inter-service URLs ─────────────────────────────────────────────────────
# Inside Docker Compose these are hardcoded; set for local dev only.
TEXT_SERVICE_URL=http://localhost:4002
AUDIO_SERVICE_URL=http://localhost:4003
AI_ORCHESTRATOR_URL=http://localhost:4005

# ── Sentry ─────────────────────────────────────────────────────────────────
# Set the matching DSN for each service (get DSNs from your Sentry project settings).
# Frontend uses NEXT_PUBLIC_SENTRY_DSN (baked at build time) as client-side DSN
# and SENTRY_DSN as server-side DSN (Next.js server / edge functions).
# Leave blank to disable Sentry for a service.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── CSRF ───────────────────────────────────────────────────────────────────
# Allowed origins for Next.js API routes (comma-separated).
# Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000

# ── Contact form SMTP ──────────────────────────────────────────────────────
# Used by the frontend /api/contact route to send feedback emails.
# Gmail SMTP — use an app password, not your regular Gmail password.
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=your_gmail@gmail.com
CONTACT_SMTP_PASS=your_gmail_app_password_here
CONTACT_TO_EMAIL=your_contact_email@example.com

# ── Service ports (optional — defaults are shown) ──────────────────────────
# PORT=4001   # auth-service
# PORT=4002   # text-service
# PORT=4003   # audio-service
# PORT=4004   # stats-service
# PORT=4005   # ai-orchestrator
# PORT=8080   # api-gateway
# PORT=3000   # frontend
